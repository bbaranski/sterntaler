<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.foerderverein</groupId>
  <artifactId>kasse</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Sterntaler</name>
  <description>Kassenfuehrung fuer den Schul-Foerderverein: Umsatzverwaltung mit HBCI-Anbindung, Mitgliederverwaltung, Berichte.</description>
  <url>https://github.com/bbaranski/sterntaler</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Bastian Baranski</name>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/bbaranski/sterntaler</url>
    <connection>scm:git:https://github.com/bbaranski/sterntaler.git</connection>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <javafx.version>21.0.12</javafx.version>
    <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
    <flyway.version>13.3.0</flyway.version>
    <hbci4j.version>4.1.12</hbci4j.version>
    <java-keyring.version>1.0.4</java-keyring.version>
    <slf4j.version>2.0.18</slf4j.version>
    <logback.version>1.5.38</logback.version>
    <junit.version>5.11.4</junit.version>
    <openpdf.version>3.0.5</openpdf.version>
    <!-- Nur fuer die Handbuch-Erzeugung, siehe exec-Ausfuehrung "handbuch" weiter unten -->
    <flexmark.version>0.64.8</flexmark.version>
    <openhtmltopdf.version>1.0.10</openhtmltopdf.version>
    <poi.version>5.5.1</poi.version>

    <!-- Kommt transitiv ueber openpdf -> brotli4j herein; hier nur, damit das Profil
         "plattformuebergreifend" die Windows-Natives derselben Fassung nachziehen kann.
         Nach einem openpdf-Update mit "mvn -o dependency:tree" abgleichen. -->
    <brotli4j.version>1.23.0</brotli4j.version>

    <!-- Overridden per OS profile below -->
    <javafx.platform>mac-aarch64</javafx.platform>
    <app.main.class>de.foerderverein.kasse.app.Launcher</app.main.class>
    <uber.jar>${project.build.directory}/app/kasse-app.jar</uber.jar>
  </properties>

  <dependencies>
    <!-- UI -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>

    <!-- Persistenz -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-nc-sqlite</artifactId>
      <version>${flyway.version}</version>
    </dependency>

    <!-- HBCI/FinTS -->
    <dependency>
      <groupId>com.github.hbci4j</groupId>
      <artifactId>hbci4j-core</artifactId>
      <version>${hbci4j.version}</version>
    </dependency>

    <!-- Zugangsdaten im OS-Schluesselbund -->
    <dependency>
      <groupId>com.github.javakeyring</groupId>
      <artifactId>java-keyring</artifactId>
      <version>${java-keyring.version}</version>
    </dependency>

    <!-- PDF-Berichte -->
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>${openpdf.version}</version>
    </dependency>

    <!-- Excel-Export -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <!-- Leitet POIs Log4j2-Logging in unser SLF4J/Logback um, sonst meldet Log4j beim Excel-Export
         "could not find a logging provider" auf der Konsole. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-to-slf4j</artifactId>
      <version>2.24.3</version>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
    </dependency>

    <!-- Handbuch: Markdown -> HTML -> PDF. Bewusst "provided": gebraucht wird das nur beim
         Erzeugen von docs/handbuch.pdf durch de.foerderverein.kasse.doc.HandbuchPdf, nicht zur
         Laufzeit der Anwendung - so bleiben die Abhaengigkeiten aus dem Uber-Jar heraus. -->
    <dependency>
      <groupId>com.vladsch.flexmark</groupId>
      <artifactId>flexmark-all</artifactId>
      <version>${flexmark.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.openhtmltopdf</groupId>
      <artifactId>openhtmltopdf-pdfbox</artifactId>
      <version>${openhtmltopdf.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>kasse</finalName>
    <resources>
      <!-- Der Standard-Ressourcenordner muss hier mit aufgefuehrt werden: sobald <resources>
           gesetzt ist, gilt die Voreinstellung nicht mehr. -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Das fertige Handbuch wandert ins Jar, damit "Hilfe -> Handbuch" es ohne Internet
           anzeigen kann. Erzeugt wird es aus docs/handbuch.md, siehe Profil "handbuch". -->
      <resource>
        <directory>docs</directory>
        <includes>
          <include>handbuch.pdf</include>
        </includes>
        <targetPath>de/foerderverein/kasse/doc</targetPath>
      </resource>
      <!-- Lizenz und Drittanbieter-Hinweise wandern wie das Handbuch ins Jar, damit
           "Hilfe -> Ueber Sterntaler" sie ohne Internet anzeigen kann. -->
      <resource>
        <directory>${project.basedir}</directory>
        <includes>
          <include>LICENSE</include>
          <include>DRITTANBIETER.md</include>
        </includes>
        <targetPath>de/foerderverein/kasse/doc</targetPath>
      </resource>
      <!-- Eigener Ordner nur fuer gefilterte Ressourcen. src/main/resources darf NICHT
           gefiltert werden: logback.xml enthaelt ${user.home} und ${LOG_DIR} als
           Logback-Platzhalter. Maven loeste ${user.home} beim Bauen auf und braennte den
           Pfad des Baurechners ins Release ein - die Protokolle landeten auf fremden
           Rechnern in einem Verzeichnis, das es dort nicht gibt. -->
      <resource>
        <directory>src/main/resources-gefiltert</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <!-- Legt Lizenz und Drittanbieter-Hinweise neben das Uber-Jar. jpackage nimmt sein
           Eingabeverzeichnis vollstaendig auf, damit liegen beide Dateien im fertigen
           Programm. "licenseFile" allein genuegt dafuer nicht: Das zeigt den Text nur im
           Installationsprogramm an und installiert ihn nicht mit. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>lizenzdateien-neben-das-jar</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/app</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}</directory>
                  <includes>
                    <include>LICENSE</include>
                    <include>DRITTANBIETER.md</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Erzeugt DRITTANBIETER.md: "mvn -o license:add-third-party@drittanbieter".
           <phase>none</phase> ist Absicht und darf nicht wegfallen: Das Ziel haengt sich sonst
           selbst an generate-resources und liefe bei jedem Bau mit. Wie beim Handbuch gilt:
           von Hand erzeugt, eingecheckt, von LizenzTest bewacht. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.4.0</version>
        <executions>
          <execution>
            <id>drittanbieter</id>
            <phase>none</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.basedir}</outputDirectory>
              <thirdPartyFilename>DRITTANBIETER.md</thirdPartyFilename>
              <fileTemplate>${project.basedir}/src/license/DRITTANBIETER.md.ftl</fileTemplate>
              <encoding>UTF-8</encoding>
              <!-- Weissliste statt Schwarzliste: In die Liste gehoert nur, was auch
                   ausgeliefert wird. flexmark und openhtmltopdf (provided, nur fuer die
                   Handbuch-Erzeugung) und JUnit (test) bleiben damit draussen. -->
              <includedScopes>compile,runtime</includedScopes>
              <useMissingFile>true</useMissingFile>
              <missingFile>${project.basedir}/src/license/fehlende-lizenzen.properties</missingFile>
              <licenseMerges>
                <licenseMerge>Apache License, Version 2.0|Apache 2.0|Apache-2.0|The Apache Software License, Version 2.0|Apache License 2.0|The Apache License, Version 2.0</licenseMerge>
                <licenseMerge>MIT License|MIT|The MIT License|The MIT License (MIT)</licenseMerge>
                <licenseMerge>GNU Lesser General Public License, Version 2.1|LGPL 2.1|LGPL-2.1|GNU Lesser General Public License|LGPL-2.1-or-later|LGPL-2.1-only|GNU Lesser General Public License (LGPL), Version 2.1</licenseMerge>
                <licenseMerge>Eclipse Distribution License 1.0|EDL 1.0|Eclipse Distribution License - v 1.0</licenseMerge>
                <!-- BSD-2 und BSD-3 bleiben getrennt: Das sind verschiedene Lizenzen. -->
                <licenseMerge>BSD 3-Clause License|BSD-3|BSD License</licenseMerge>
              </licenseMerges>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Erzeugt docs/handbuch.pdf aus docs/handbuch.md: "mvn -o compile exec:java@handbuch".
           Bewusst an keine Phase gebunden - ein PDF traegt einen Erzeugungszeitpunkt, bei jedem
           Build neu geschrieben waere die Datei also staendig geaendert, ohne dass sich am Text
           etwas getan haette. HandbuchPdfTest schlaegt fehl, wenn das Erzeugen vergessen wird. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>handbuch</id>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>de.foerderverein.kasse.doc.HandbuchPdf</mainClass>
              <classpathScope>compile</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Baut ein Uber-Jar inkl. JavaFX (plattformspezifisch) als reine Klassenpfad-Anwendung,
           damit jpackage kein JavaFX-Modulpfad-Setup braucht. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- Eigenes Verzeichnis statt target/: jpackage nimmt sein Eingabeverzeichnis
                   vollstaendig in die Anwendung auf, und in target/ liegen auch classes/,
                   test-classes/ und das nicht gebuendelte kasse.jar - die haben in einer
                   ausgelieferten Anwendung nichts zu suchen. -->
              <outputFile>${uber.jar}</outputFile>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${app.main.class}</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>mac-aarch64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <javafx.platform>mac-aarch64</javafx.platform>
        <!-- Ueberschreibbar, z. B. "-Djpackage.type=APP_IMAGE" fuer ein Programmverzeichnis
             ohne Installationspaket. -->
        <jpackage.type>DMG</jpackage.type>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.8.0</version>
            <configuration>
              <name>Sterntaler</name>
              <!-- jpackage verlangt eine reine Zahlenfolge: Eine Projektfassung mit
                   "-SNAPSHOT" laesst den Paketbau fehlschlagen. Das ist hier erwuenscht -
                   ausgeliefert wird nur aus einer Release-Fassung heraus. -->
              <appVersion>${project.version}</appVersion>
              <!-- Bewusst KEIN licenseFile: Auf macOS macht jpackage daraus eine
                   Lizenzvereinbarung, die vor dem Oeffnen des DMG bestaetigt werden muss -
                   fuer ein freizuegig lizenziertes Vereinsprogramm unnoetige Huerde, und
                   automatisiertes Pruefen wird damit unmoeglich. Zudem lehnt jpackage die
                   Angabe bei "-Djpackage.type=APP_IMAGE" rundweg ab, also genau beim
                   Rueckfallweg ohne WiX - dasselbe gilt fuer aboutUrl. Von den Angaben hier
                   vertraegt sich nur copyright mit allen Pakettypen. Lizenz und Hinweise
                   liegen stattdessen im
                   Programmverzeichnis (siehe maven-resources-plugin oben) und im
                   Ueber-Dialog. -->
              <copyright>Copyright (c) 2026 Bastian Baranski</copyright>
              <!-- Das Schuerzen-Logo als Programmicon. Die .icns enthaelt je Groesse
                   eine eigene Zeichnung: ab 128 px die Fassung mit Sternenregen,
                   darunter die kompakte ohne - in 32 px waeren die fallenden Sterne
                   nur noch Rauschen. Siehe logo/README.md. -->
              <icon>${project.basedir}/logo/sterntaler.icns</icon>
              <vendor>Foerderverein</vendor>
              <input>${project.build.directory}/app</input>
              <mainJar>kasse-app.jar</mainJar>
              <mainClass>${app.main.class}</mainClass>
              <destination>${project.build.directory}/dist</destination>
              <type>${jpackage.type}</type>
              <javaOptions>
                <option>-Dfile.encoding=UTF-8</option>
              </javaOptions>
              <!-- Ermittelt mit jdeps (print-module-deps ueber target/app/kasse-app.jar),
                   ergaenzt um die Module, die jdeps nicht sehen kann,
                   weil sie ueber Dienste oder Reflexion geladen werden (Logging, JNDI, XML,
                   TLS-Anbieter, Laenderdaten). jdk.unsupported ist nicht optional: JavaFX
                   braucht daraus sun.misc.Unsafe, sonst startet die Anwendung zwar, kann ihr
                   Fenster aber nicht zeichnen. -->
              <addModules>
                <module>java.base</module>
                <module>java.compiler</module>
                <module>java.desktop</module>
                <module>java.logging</module>
                <module>java.naming</module>
                <module>java.prefs</module>
                <module>java.scripting</module>
                <module>java.security.jgss</module>
                <module>java.smartcardio</module>
                <module>java.sql</module>
                <module>java.xml</module>
                <module>java.xml.crypto</module>
                <module>jdk.crypto.cryptoki</module>
                <module>jdk.crypto.ec</module>
                <module>jdk.jfr</module>
                <module>jdk.localedata</module>
                <module>jdk.net</module>
                <module>jdk.security.auth</module>
                <module>jdk.unsupported</module>
              </addModules>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>mac-x86_64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <properties>
        <javafx.platform>mac</javafx.platform>
        <jpackage.type>DMG</jpackage.type>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.8.0</version>
            <configuration>
              <name>Sterntaler</name>
              <appVersion>${project.version}</appVersion>
              <!-- Bewusst KEIN licenseFile: Auf macOS macht jpackage daraus eine
                   Lizenzvereinbarung, die vor dem Oeffnen des DMG bestaetigt werden muss -
                   fuer ein freizuegig lizenziertes Vereinsprogramm unnoetige Huerde, und
                   automatisiertes Pruefen wird damit unmoeglich. Zudem lehnt jpackage die
                   Angabe bei "-Djpackage.type=APP_IMAGE" rundweg ab, also genau beim
                   Rueckfallweg ohne WiX - dasselbe gilt fuer aboutUrl. Von den Angaben hier
                   vertraegt sich nur copyright mit allen Pakettypen. Lizenz und Hinweise
                   liegen stattdessen im
                   Programmverzeichnis (siehe maven-resources-plugin oben) und im
                   Ueber-Dialog. -->
              <copyright>Copyright (c) 2026 Bastian Baranski</copyright>
              <!-- Das Schuerzen-Logo als Programmicon. Die .icns enthaelt je Groesse
                   eine eigene Zeichnung: ab 128 px die Fassung mit Sternenregen,
                   darunter die kompakte ohne - in 32 px waeren die fallenden Sterne
                   nur noch Rauschen. Siehe logo/README.md. -->
              <icon>${project.basedir}/logo/sterntaler.icns</icon>
              <vendor>Foerderverein</vendor>
              <input>${project.build.directory}/app</input>
              <mainJar>kasse-app.jar</mainJar>
              <mainClass>${app.main.class}</mainClass>
              <destination>${project.build.directory}/dist</destination>
              <type>${jpackage.type}</type>
              <addModules>
                <module>java.base</module>
                <module>java.compiler</module>
                <module>java.desktop</module>
                <module>java.logging</module>
                <module>java.naming</module>
                <module>java.prefs</module>
                <module>java.scripting</module>
                <module>java.security.jgss</module>
                <module>java.smartcardio</module>
                <module>java.sql</module>
                <module>java.xml</module>
                <module>java.xml.crypto</module>
                <module>jdk.crypto.cryptoki</module>
                <module>jdk.crypto.ec</module>
                <module>jdk.jfr</module>
                <module>jdk.localedata</module>
                <module>jdk.net</module>
                <module>jdk.security.auth</module>
                <module>jdk.unsupported</module>
              </addModules>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <javafx.platform>win</javafx.platform>
        <!-- EXE und MSI setzen das WiX Toolset auf dem Baurechner voraus; ohne das liefert
             "-Djpackage.type=APP_IMAGE" ein startbares Programmverzeichnis. -->
        <jpackage.type>EXE</jpackage.type>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.8.0</version>
            <configuration>
              <name>Sterntaler</name>
              <appVersion>${project.version}</appVersion>
              <!-- Bewusst KEIN licenseFile: Auf macOS macht jpackage daraus eine
                   Lizenzvereinbarung, die vor dem Oeffnen des DMG bestaetigt werden muss -
                   fuer ein freizuegig lizenziertes Vereinsprogramm unnoetige Huerde, und
                   automatisiertes Pruefen wird damit unmoeglich. Zudem lehnt jpackage die
                   Angabe bei "-Djpackage.type=APP_IMAGE" rundweg ab, also genau beim
                   Rueckfallweg ohne WiX - dasselbe gilt fuer aboutUrl. Von den Angaben hier
                   vertraegt sich nur copyright mit allen Pakettypen. Lizenz und Hinweise
                   liegen stattdessen im
                   Programmverzeichnis (siehe maven-resources-plugin oben) und im
                   Ueber-Dialog. -->
              <copyright>Copyright (c) 2026 Bastian Baranski</copyright>
              <!-- Siehe die Anmerkung in den macOS-Profilen; Windows braucht .ico. -->
              <icon>${project.basedir}/logo/sterntaler.ico</icon>
              <vendor>Foerderverein</vendor>
              <input>${project.build.directory}/app</input>
              <mainJar>kasse-app.jar</mainJar>
              <mainClass>${app.main.class}</mainClass>
              <destination>${project.build.directory}/dist</destination>
              <type>${jpackage.type}</type>
              <winDirChooser>true</winDirChooser>
              <winMenu>true</winMenu>
              <winShortcut>true</winShortcut>
              <addModules>
                <module>java.base</module>
                <module>java.compiler</module>
                <module>java.desktop</module>
                <module>java.logging</module>
                <module>java.naming</module>
                <module>java.prefs</module>
                <module>java.scripting</module>
                <module>java.security.jgss</module>
                <module>java.smartcardio</module>
                <module>java.sql</module>
                <module>java.xml</module>
                <module>java.xml.crypto</module>
                <module>jdk.crypto.cryptoki</module>
                <module>jdk.crypto.ec</module>
                <module>jdk.jfr</module>
                <module>jdk.localedata</module>
                <module>jdk.net</module>
                <module>jdk.security.auth</module>
                <module>jdk.unsupported</module>
              </addModules>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Ein einziges ausfuehrbares Jar fuer Windows x64 UND macOS Apple Silicon, nur ueber
         "-Pplattformuebergreifend" aktiv. Setzt ein installiertes Java 21 voraus - eine
         mitgelieferte Laufzeit besteht aus nativem Code und kann nicht fuer zwei Systeme
         zugleich gelten, dafuer gibt es die jpackage-Profile oben.

         Dieses Profil steht bewusst als letztes: Es setzt javafx.platform fest, und bei
         gleichnamigen Eigenschaften gewinnt das zuletzt deklarierte Profil.

         Bauen mit:  mvn -Pplattformuebergreifend -Djavafx.platform=mac-aarch64 clean package
         Das -D gehoert dazu - es haelt die transitive Aufloesung der OpenJFX-Artefakte fest,
         die sonst dem Baurechner folgt und auf einem fremden Laeufer noch einen dritten
         Plattformsatz hereinzoege.

         Nicht erweiterbar auf Intel-Macs: Deren JavaFX-Natives heissen genauso wie die fuer
         Apple Silicon (libglass.dylib und weitere) und wuerden einander im Jar ueberschreiben.
         Gegen Windows kollidieren sie nicht (glass.dll). -->
    <profile>
      <id>plattformuebergreifend</id>
      <properties>
        <javafx.platform>mac-aarch64</javafx.platform>
        <!-- NICHT nach target/app: dort liegt die Eingabe fuer jpackage, und jpackage nimmt
             sein Eingabeverzeichnis vollstaendig auf - das Jar wanderte sonst mit ins DMG. -->
        <uber.jar>${project.build.directory}/plattformuebergreifend/Sterntaler.jar</uber.jar>
      </properties>
      <dependencies>
        <!-- Beide Plattformen stehen hier mit literalem Classifier, und das ist der Kern der
             Sache: Die OpenJFX-POMs waehlen ihren Classifier ueber eigene os-Profile anhand des
             BAURECHNERS. Ohne diese Festlegung zoege ein Bau auf einem Linux-Laeufer die
             Linux-Natives statt der Mac-Natives herein, und das Jar liefe auf keinem Mac.
             Nachweisbar mit "mvn dependency:tree -Pplattformuebergreifend -Djavafx.platform=win":
             ohne die Eintraege hier verschwindet die Mac-Seite vollstaendig.

             javafx-controls und javafx-fxml stehen fuer die Mac-Seite schon oben in den
             Basis-Abhaengigkeiten (ueber javafx.platform) und fehlen hier deshalb absichtlich. -->
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-base</artifactId>
          <version>${javafx.version}</version>
          <classifier>mac-aarch64</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>${javafx.version}</version>
          <classifier>mac-aarch64</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-base</artifactId>
          <version>${javafx.version}</version>
          <classifier>win</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>${javafx.version}</version>
          <classifier>win</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-controls</artifactId>
          <version>${javafx.version}</version>
          <classifier>win</classifier>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-fxml</artifactId>
          <version>${javafx.version}</version>
          <classifier>win</classifier>
        </dependency>
        <!-- openpdf zieht ueber brotli4j nur die Natives des Baurechners nach; die Windows-
             Variante muss daher ausdruecklich dazu. Die beiden liegen in verschiedenen
             Verzeichnissen im Jar und kollidieren nicht. -->
        <dependency>
          <groupId>com.aayushatharva.brotli4j</groupId>
          <artifactId>native-windows-x86_64</artifactId>
          <version>${brotli4j.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
