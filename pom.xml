<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.foerderverein</groupId>
  <artifactId>kasse</artifactId>
  <version>1.0.1</version>
  <packaging>jar</packaging>

  <name>Sterntaler</name>
  <description>Kassenfuehrung fuer den Schul-Foerderverein: Umsatzverwaltung mit HBCI-Anbindung, Mitgliederverwaltung, Berichte.</description>
  <url>https://github.com/bbaranski/sterntaler</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Bastian Baranski</name>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/bbaranski/sterntaler</url>
    <connection>scm:git:https://github.com/bbaranski/sterntaler.git</connection>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <javafx.version>21.0.12</javafx.version>
    <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
    <flyway.version>13.3.0</flyway.version>
    <hbci4j.version>4.1.12</hbci4j.version>
    <java-keyring.version>1.0.4</java-keyring.version>
    <slf4j.version>2.0.18</slf4j.version>
    <logback.version>1.5.38</logback.version>
    <junit.version>5.11.4</junit.version>
    <openpdf.version>3.0.5</openpdf.version>
    <!-- Nur fuer die Handbuch-Erzeugung, siehe exec-Ausfuehrung "handbuch" weiter unten -->
    <flexmark.version>0.64.8</flexmark.version>
    <openhtmltopdf.version>1.0.10</openhtmltopdf.version>
    <poi.version>5.5.1</poi.version>

    <!-- Overridden per OS profile below -->
    <javafx.platform>mac-aarch64</javafx.platform>
    <app.main.class>de.foerderverein.kasse.app.Launcher</app.main.class>
    <uber.jar>${project.build.directory}/app/Sterntaler.jar</uber.jar>
  </properties>

  <dependencies>
    <!-- UI -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>

    <!-- Persistenz -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-nc-sqlite</artifactId>
      <version>${flyway.version}</version>
    </dependency>

    <!-- HBCI/FinTS -->
    <dependency>
      <groupId>com.github.hbci4j</groupId>
      <artifactId>hbci4j-core</artifactId>
      <version>${hbci4j.version}</version>
    </dependency>

    <!-- Zugangsdaten im OS-Schluesselbund -->
    <dependency>
      <groupId>com.github.javakeyring</groupId>
      <artifactId>java-keyring</artifactId>
      <version>${java-keyring.version}</version>
    </dependency>

    <!-- PDF-Berichte -->
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>${openpdf.version}</version>
    </dependency>

    <!-- Excel-Export -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <!-- Leitet POIs Log4j2-Logging in unser SLF4J/Logback um, sonst meldet Log4j beim Excel-Export
         "could not find a logging provider" auf der Konsole. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-to-slf4j</artifactId>
      <version>2.24.3</version>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
    </dependency>

    <!-- Handbuch: Markdown -> HTML -> PDF. Bewusst "provided": gebraucht wird das nur beim
         Erzeugen von docs/handbuch.pdf durch de.foerderverein.kasse.doc.HandbuchPdf, nicht zur
         Laufzeit der Anwendung - so bleiben die Abhaengigkeiten aus dem Uber-Jar heraus. -->
    <dependency>
      <groupId>com.vladsch.flexmark</groupId>
      <artifactId>flexmark-all</artifactId>
      <version>${flexmark.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.openhtmltopdf</groupId>
      <artifactId>openhtmltopdf-pdfbox</artifactId>
      <version>${openhtmltopdf.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>kasse</finalName>
    <resources>
      <!-- Der Standard-Ressourcenordner muss hier mit aufgefuehrt werden: sobald <resources>
           gesetzt ist, gilt die Voreinstellung nicht mehr. -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Das fertige Handbuch wandert ins Jar, damit "Hilfe -> Handbuch" es ohne Internet
           anzeigen kann. Erzeugt wird es aus docs/handbuch.md, siehe Profil "handbuch". -->
      <resource>
        <directory>docs</directory>
        <includes>
          <include>handbuch.pdf</include>
        </includes>
        <targetPath>de/foerderverein/kasse/doc</targetPath>
      </resource>
      <!-- Lizenz und Drittanbieter-Hinweise wandern wie das Handbuch ins Jar, damit
           "Hilfe -> Ueber Sterntaler" sie ohne Internet anzeigen kann. -->
      <resource>
        <directory>${project.basedir}</directory>
        <includes>
          <include>LICENSE</include>
          <include>DRITTANBIETER.md</include>
        </includes>
        <targetPath>de/foerderverein/kasse/doc</targetPath>
      </resource>
      <!-- Eigener Ordner nur fuer gefilterte Ressourcen. src/main/resources darf NICHT
           gefiltert werden: logback.xml enthaelt ${user.home} und ${LOG_DIR} als
           Logback-Platzhalter. Maven loeste ${user.home} beim Bauen auf und braennte den
           Pfad des Baurechners ins Release ein - die Protokolle landeten auf fremden
           Rechnern in einem Verzeichnis, das es dort nicht gibt. -->
      <resource>
        <directory>src/main/resources-gefiltert</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <!-- Legt Lizenz und Drittanbieter-Hinweise neben das Uber-Jar, damit sie beim
           Weitergeben des Jars nicht fehlen. Im Jar selbst liegen sie zusaetzlich, siehe
           <resources> oben - daraus zeigt sie der Ueber-Dialog. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>lizenzdateien-neben-das-jar</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/app</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}</directory>
                  <includes>
                    <include>LICENSE</include>
                    <include>DRITTANBIETER.md</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Erzeugt DRITTANBIETER.md: "mvn -o license:add-third-party@drittanbieter".
           <phase>none</phase> ist Absicht und darf nicht wegfallen: Das Ziel haengt sich sonst
           selbst an generate-resources und liefe bei jedem Bau mit. Wie beim Handbuch gilt:
           von Hand erzeugt, eingecheckt, von LizenzTest bewacht. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.4.0</version>
        <executions>
          <execution>
            <id>drittanbieter</id>
            <phase>none</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.basedir}</outputDirectory>
              <thirdPartyFilename>DRITTANBIETER.md</thirdPartyFilename>
              <fileTemplate>${project.basedir}/src/license/DRITTANBIETER.md.ftl</fileTemplate>
              <encoding>UTF-8</encoding>
              <!-- Weissliste statt Schwarzliste: In die Liste gehoert nur, was auch
                   ausgeliefert wird. flexmark und openhtmltopdf (provided, nur fuer die
                   Handbuch-Erzeugung) und JUnit (test) bleiben damit draussen. -->
              <includedScopes>compile,runtime</includedScopes>
              <useMissingFile>true</useMissingFile>
              <missingFile>${project.basedir}/src/license/fehlende-lizenzen.properties</missingFile>
              <licenseMerges>
                <licenseMerge>Apache License, Version 2.0|Apache 2.0|Apache-2.0|The Apache Software License, Version 2.0|Apache License 2.0|The Apache License, Version 2.0</licenseMerge>
                <licenseMerge>MIT License|MIT|The MIT License|The MIT License (MIT)</licenseMerge>
                <licenseMerge>GNU Lesser General Public License, Version 2.1|LGPL 2.1|LGPL-2.1|GNU Lesser General Public License|LGPL-2.1-or-later|LGPL-2.1-only|GNU Lesser General Public License (LGPL), Version 2.1</licenseMerge>
                <licenseMerge>Eclipse Distribution License 1.0|EDL 1.0|Eclipse Distribution License - v 1.0</licenseMerge>
                <!-- BSD-2 und BSD-3 bleiben getrennt: Das sind verschiedene Lizenzen. -->
                <licenseMerge>BSD 3-Clause License|BSD-3|BSD License</licenseMerge>
              </licenseMerges>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Erzeugt docs/handbuch.pdf aus docs/handbuch.md: "mvn -o compile exec:java@handbuch".
           Bewusst an keine Phase gebunden - ein PDF traegt einen Erzeugungszeitpunkt, bei jedem
           Build neu geschrieben waere die Datei also staendig geaendert, ohne dass sich am Text
           etwas getan haette. HandbuchPdfTest schlaegt fehl, wenn das Erzeugen vergessen wird. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>handbuch</id>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>de.foerderverein.kasse.doc.HandbuchPdf</mainClass>
              <classpathScope>compile</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Baut ein Uber-Jar inkl. JavaFX (plattformspezifisch) als reine
           Klassenpfad-Anwendung: So startet es mit "java -jar" ohne Modulpfad-Setup. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- Eigenes Verzeichnis statt target/: Dort liegen auch classes/,
                   test-classes/ und das nicht gebuendelte kasse.jar. Neben dem Uber-Jar
                   sollen allein Lizenz und Drittanbieter-Hinweise liegen, siehe
                   maven-resources-plugin oben. -->
              <outputFile>${uber.jar}</outputFile>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${app.main.class}</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Die Profile legen allein den JavaFX-Classifier anhand des Baurechners fest: Die
       JavaFX-Natives sind plattformgebunden, und ohne die Festlegung zoege ein fremder
       Baurechner den falschen Satz herein. -->
  <profiles>
    <profile>
      <id>mac-aarch64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <javafx.platform>mac-aarch64</javafx.platform>
      </properties>
    </profile>

    <profile>
      <id>mac-x86_64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>x86_64</arch>
        </os>
      </activation>
      <properties>
        <javafx.platform>mac</javafx.platform>
      </properties>
    </profile>

    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <javafx.platform>win</javafx.platform>
      </properties>
    </profile>
  </profiles>
</project>
