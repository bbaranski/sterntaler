<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.foerderverein.kasse.ui.MainController">
    <top>
        <MenuBar useSystemMenuBar="true">
            <menus>
                <Menu text="Einstellungen">
                    <items>
                        <MenuItem text="Vereinsdaten…" onAction="#onVereinsdaten" />
                        <MenuItem text="Kategorien…" onAction="#onKategorien" />
                        <MenuItem text="Konto-Einstellungen…" onAction="#onKontoEinstellungen" />
                        <MenuItem text="Geschäftsjahre…" onAction="#onGeschaeftsjahre" />
                        <MenuItem text="Aktivitäten/Veranstaltungen…" onAction="#onAktivitaeten" />
                    </items>
                </Menu>
                <Menu text="Berichte">
                    <items>
                        <MenuItem text="Kassenbericht…" onAction="#onKassenbericht" />
                        <MenuItem text="Ergänzung zur Steuererklärung…" onAction="#onSteuerreport" />
                    </items>
                </Menu>
                <Menu text="Import">
                    <items>
                        <MenuItem text="Mitgliederliste importieren…" onAction="#onMitgliederlisteImport" />
                    </items>
                </Menu>
                <Menu text="Exporte">
                    <items>
                        <MenuItem text="Mitgliederliste exportieren…" onAction="#onMitgliederlisteExport" />
                        <MenuItem text="Kontobewegungen exportieren…" onAction="#onKontobewegungenExport" />
                        <MenuItem text="Sicherheitskopie…" onAction="#onSicherheitskopie" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Buchungen">
                    <content>
                        <fx:include fx:id="buchungenView" source="BuchungenView.fxml" />
                    </content>
                </Tab>
                <Tab text="Mitglieder">
                    <content>
                        <fx:include fx:id="mitgliederView" source="MitgliederView.fxml" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
