<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" prefWidth="480"
            fx:controller="de.foerderverein.kasse.ui.VereinDialogController">
    <center>
        <GridPane hgap="8" vgap="8">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16" />
            </padding>
            <Label text="Name" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Straße" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="strasseField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="PLZ" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="plzField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="Ort" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <TextField fx:id="ortField" GridPane.rowIndex="3" GridPane.columnIndex="1" />

            <Label text="Telefon" GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <TextField fx:id="telefonField" GridPane.rowIndex="4" GridPane.columnIndex="1" />

            <Label text="E-Mail" GridPane.rowIndex="5" GridPane.columnIndex="0" />
            <TextField fx:id="emailField" GridPane.rowIndex="5" GridPane.columnIndex="1" />

            <Label text="Homepage" GridPane.rowIndex="6" GridPane.columnIndex="0" />
            <TextField fx:id="homepageField" GridPane.rowIndex="6" GridPane.columnIndex="1" />

            <Label text="IBAN" GridPane.rowIndex="7" GridPane.columnIndex="0" />
            <TextField fx:id="ibanField" GridPane.rowIndex="7" GridPane.columnIndex="1" />

            <Label text="BIC" GridPane.rowIndex="8" GridPane.columnIndex="0" />
            <TextField fx:id="bicField" GridPane.rowIndex="8" GridPane.columnIndex="1" />

            <Label text="Name der Bank" GridPane.rowIndex="9" GridPane.columnIndex="0" />
            <TextField fx:id="banknameField" GridPane.rowIndex="9" GridPane.columnIndex="1" />

            <columnConstraints>
                <javafx.scene.layout.ColumnConstraints minWidth="120" />
                <javafx.scene.layout.ColumnConstraints minWidth="280" hgrow="ALWAYS" />
            </columnConstraints>
        </GridPane>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="8" right="16" bottom="16" left="16" />
            </padding>
            <Label fx:id="fehlerLabel" styleClass="fehler-label" wrapText="true" />
            <Button text="Schließen" onAction="#onSchliessen" />
            <Button text="Speichern" onAction="#onSpeichern" defaultButton="true" />
        </HBox>
    </bottom>
</BorderPane>
