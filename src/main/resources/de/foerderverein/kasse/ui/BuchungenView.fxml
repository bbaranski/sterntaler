<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.foerderverein.kasse.ui.BuchungenViewController">
    <top>
        <HBox spacing="8" styleClass="toolbar">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8" />
            </padding>
            <Button text="Neue Buchung" onAction="#onNeueBuchung" disable="true" />
            <Button fx:id="bearbeitenButton" text="Bearbeiten" onAction="#onBearbeiten" disable="true" />
            <Button fx:id="stornierenButton" text="Stornieren" onAction="#onStornieren" disable="true" />
            <Button fx:id="verlaufButton" text="Verlauf…" onAction="#onVerlauf" disable="true" />
            <Separator orientation="VERTICAL" />
            <Button text="HBCI-Abruf…" onAction="#onHbciAbruf" />
            <Separator orientation="VERTICAL" />
            <Button text="Spalten…" onAction="#onSpalten" />
            <Separator orientation="VERTICAL" />
            <TextField fx:id="suchFeld" promptText="Suchen…" prefWidth="220" />
            <Button fx:id="suchZurueckButton" text="◀" />
            <Button fx:id="suchWeiterButton" text="▶" />
            <Label fx:id="suchTrefferLabel" />
        </HBox>
    </top>
    <center>
        <TableView fx:id="buchungenTable" editable="true">
            <columns>
                <TableColumn fx:id="datumColumn" text="Datum" prefWidth="90" />
                <TableColumn fx:id="geschaeftsjahrColumn" text="Geschäftsjahr" prefWidth="110" />
                <TableColumn fx:id="kontoauszugColumn" text="Kontoauszug" prefWidth="110" />
                <TableColumn fx:id="betragColumn" text="Betrag" prefWidth="100" />
                <TableColumn fx:id="saldoColumn" text="Saldo" prefWidth="100" />
                <TableColumn fx:id="kategorieColumn" text="Kategorie" prefWidth="160" />
                <TableColumn fx:id="aktivitaetColumn" text="Aktivität" prefWidth="140" />
                <TableColumn fx:id="verwendungszweckColumn" text="Verwendungszweck" prefWidth="260" />
                <TableColumn fx:id="gegenkontoColumn" text="Gegenkonto" prefWidth="160" />
                <TableColumn fx:id="quelleColumn" text="Quelle" prefWidth="100" />
                <TableColumn fx:id="rechnungsnummerColumn" text="Rechnungsnummer" prefWidth="130" />
                <TableColumn fx:id="belegColumn" text="Beleg" prefWidth="180" />
                <TableColumn fx:id="kontoColumn" text="Konto" prefWidth="140" visible="false" />
                <TableColumn fx:id="wertstellungColumn" text="Wertstellung" prefWidth="100" visible="false" />
                <TableColumn fx:id="waehrungColumn" text="Währung" prefWidth="80" visible="false" />
                <TableColumn fx:id="gegenkontoIbanColumn" text="Gegenkonto IBAN" prefWidth="180" visible="false" />
                <TableColumn fx:id="storniertColumn" text="Storniert" prefWidth="80" visible="false" />
                <TableColumn fx:id="erstelltVonColumn" text="Erstellt von" prefWidth="120" visible="false" />
                <TableColumn fx:id="erstelltAmColumn" text="Erstellt am" prefWidth="140" visible="false" />
                <TableColumn fx:id="geaendertAmColumn" text="Geändert am" prefWidth="140" visible="false" />
                <TableColumn fx:id="hbciHashColumn" text="HBCI-Import-Hash" prefWidth="220" visible="false" />
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60" visible="false" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox styleClass="statusbar">
            <padding>
                <Insets top="4" right="8" bottom="4" left="8" />
            </padding>
            <Label fx:id="statusLabel" text=" " />
        </HBox>
    </bottom>
</BorderPane>
