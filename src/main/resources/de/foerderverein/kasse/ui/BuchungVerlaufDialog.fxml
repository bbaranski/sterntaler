<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" prefWidth="640" prefHeight="360"
            fx:controller="de.foerderverein.kasse.ui.BuchungVerlaufDialogController">
    <top>
        <VBox spacing="4">
            <padding>
                <Insets top="12" right="12" bottom="8" left="12" />
            </padding>
            <Label fx:id="ueberschriftLabel" style="-fx-font-weight: bold;" />
        </VBox>
    </top>
    <center>
        <TableView fx:id="verlaufTable">
            <padding>
                <Insets top="0" right="12" bottom="12" left="12" />
            </padding>
            <columns>
                <TableColumn fx:id="zeitpunktColumn" text="Zeitpunkt" prefWidth="150" />
                <TableColumn fx:id="aktionColumn" text="Aktion" prefWidth="100" />
                <TableColumn fx:id="benutzerColumn" text="Benutzer" prefWidth="120" />
                <TableColumn fx:id="detailsColumn" text="Details" prefWidth="260" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="0" right="12" bottom="12" left="12" />
            </padding>
            <Button text="Schließen" onAction="#onSchliessen" />
        </HBox>
    </bottom>
</BorderPane>
