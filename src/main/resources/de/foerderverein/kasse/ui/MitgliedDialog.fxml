<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" prefWidth="760" prefHeight="520"
            fx:controller="de.foerderverein.kasse.ui.MitgliedDialogController">
    <center>
        <HBox spacing="12">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12" />
            </padding>
            <TableView fx:id="mitgliederTable" prefWidth="320" HBox.hgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="180" />
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="80" />
                </columns>
            </TableView>
            <VBox spacing="8" prefWidth="280">
                <Label text="Vorname" />
                <TextField fx:id="vornameField" />
                <Label text="Nachname" />
                <TextField fx:id="nachnameField" />
                <Label text="Straße" />
                <TextField fx:id="strasseField" />
                <HBox spacing="8">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="PLZ" />
                        <TextField fx:id="plzField" />
                    </VBox>
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Ort" />
                        <TextField fx:id="ortField" />
                    </VBox>
                </HBox>
                <Label text="E-Mail" />
                <TextField fx:id="emailField" />
                <Label text="Eintrittsdatum" />
                <DatePicker fx:id="eintrittsdatumPicker" maxWidth="Infinity" />
                <Label text="Austrittsdatum" />
                <DatePicker fx:id="austrittsdatumPicker" maxWidth="Infinity" />
                <Label text="Status" />
                <ComboBox fx:id="statusCombo" maxWidth="Infinity" />
                <Label text="Notiz" />
                <TextArea fx:id="notizField" prefRowCount="2" wrapText="true" />
                <Button text="Neu" onAction="#onNeu" />
                <Button text="Speichern" onAction="#onSpeichern" defaultButton="true" />
                <Label fx:id="fehlerLabel" styleClass="fehler-label" wrapText="true" />
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="0" right="12" bottom="12" left="12" />
            </padding>
            <Button text="Schließen" onAction="#onSchliessen" />
        </HBox>
    </bottom>
</BorderPane>
