<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" prefWidth="900" prefHeight="620"
            fx:controller="de.foerderverein.kasse.ui.BriefvorlageDialogController">
    <center>
        <HBox spacing="12">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12" />
            </padding>
            <VBox spacing="8" prefWidth="380">
                <TableView fx:id="vorlagenTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="140" />
                        <TableColumn fx:id="betreffColumn" text="Betreff" prefWidth="130" />
                        <TableColumn fx:id="dateinameColumn" text="Word-Datei" prefWidth="100" />
                    </columns>
                </TableView>
                <Label text="Platzhalter für die Word-Datei:" />
                <Label fx:id="platzhalterLabel" wrapText="true" />
            </VBox>
            <VBox spacing="8" prefWidth="460" HBox.hgrow="ALWAYS">
                <Label text="Name des Anlasses" />
                <TextField fx:id="nameField" />
                <Label text="Betreff (für E-Mail)" />
                <TextField fx:id="betreffField" />
                <Label text="Brieftext / Agenda (Vorschlag, vor dem Versand noch änderbar)" />
                <TextArea fx:id="brieftextArea" prefRowCount="8" wrapText="true" VBox.vgrow="ALWAYS" />
                <Label text="Signatur: Name" />
                <TextField fx:id="signaturNameField" />
                <Label text="Signatur: Rolle" />
                <TextField fx:id="signaturRolleField" />
                <HBox spacing="8">
                    <Button text="Word-Datei auswählen…" onAction="#onDateiWaehlen" />
                    <Label fx:id="dateiLabel" wrapText="true" />
                </HBox>
                <HBox spacing="8">
                    <Button text="Neu" onAction="#onNeu" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    <Button text="Speichern" onAction="#onSpeichern" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            defaultButton="true" />
                    <Button fx:id="loeschenButton" text="Löschen" onAction="#onLoeschen" HBox.hgrow="ALWAYS"
                            maxWidth="Infinity" disable="true" />
                </HBox>
                <Label fx:id="fehlerLabel" styleClass="fehler-label" wrapText="true" />
            </VBox>
        </HBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="0" right="12" bottom="12" left="12" />
            </padding>
            <Button text="Schließen" onAction="#onSchliessen" />
        </HBox>
    </bottom>
</BorderPane>
